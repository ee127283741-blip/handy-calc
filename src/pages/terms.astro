---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE_NAME } from '../site';
---
<PageLayout title="Terms of Use" description={`Terms for using ${SITE_NAME}: results are estimates for general information, provided as-is with no warranty.`} updated="2026-11-01">
  <h2>Estimates only</h2>
  <p>Calculator results are estimates for general information. They may be affected by rounding, assumptions stated on each page, and differences between products, ingredients, materials and equipment. Always check product labels, recipes and manufacturer instructions, and consult a qualified professional for decisions with safety, legal or financial consequences.</p>
  <h2>No warranty</h2>
  <p>The site is provided "as is" without warranties of any kind. To the extent permitted by law, we are not liable for losses arising from the use of the site or its results.</p>
  <h2>Acceptable use</h2>
  <p>You may use the calculators freely for personal and commercial purposes. Please do not attempt to disrupt the site or copy it wholesale.</p>
  <h2>External links</h2>
  <p>We link to third-party sources for reference. We are not responsible for their content.</p>
  <h2>Changes</h2>
  <p>We may update these terms; the date below shows the latest version.</p>
</PageLayout>
