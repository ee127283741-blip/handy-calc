---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { SITE_NAME, getPromptCategory } from '../../../site';
import { allPrompts, isoDate, promptUrl, splitPrompt } from '../../../lib';

export async function getStaticPaths() {
  const all = await allPrompts();
  return all.map((entry) => ({ params: { cat: entry.data.category, slug: entry.data.slug }, props: { entry, all } }));
}
const { entry, all } = Astro.props as { entry: CollectionEntry<'prompts'>; all: CollectionEntry<'prompts'>[] };
const d = entry.data;
const cat = getPromptCategory(d.category);
const path = promptUrl(entry);
const { text, tips } = splitPrompt(entry.body);
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const html = esc(text).replace(/\{\{([a-z0-9_]+)\}\}/g, '<mark>{{$1}}</mark>');
const used = new Set([...text.matchAll(/\{\{([a-z0-9_]+)\}\}/g)].map((m) => m[1]));
const declared = new Set(d.variables.map((v) => v.name));
for (const v of used) if (!declared.has(v)) throw new Error(`Prompt ${d.slug} uses undeclared variable {{${v}}}`);
for (const v of declared) if (!used.has(v)) throw new Error(`Prompt ${d.slug} declares unused variable ${v}`);
const shared = (p: CollectionEntry<'prompts'>) => p.data.tags.filter((t) => d.tags.includes(t)).length;
const related = all
  .filter((p) => p.data.slug !== d.slug)
  .map((p) => ({ p, score: (p.data.category === d.category ? 2 : 0) + shared(p) }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || a.p.data.title.localeCompare(b.p.data.title))
  .slice(0, 4)
  .map((x) => x.p);
const abs = (p: string) => new URL(p, Astro.site).href;
const jsonLd = [{
  '@type': 'CreativeWork',
  name: d.title,
  description: d.purpose,
  url: abs(path),
  text,
  genre: `${cat.name} prompt`,
  keywords: d.tags.join(', '),
  datePublished: isoDate(d.published),
  dateModified: isoDate(d.updated),
  author: { '@type': 'Organization', name: SITE_NAME },
  ...(d.image ? { image: abs(d.image) } : {}),
}];
---
<BaseLayout title={`${d.title} | ${SITE_NAME}`} description={d.purpose} jsonLd={jsonLd}>
  <Breadcrumbs items={[{ name: 'Prompts', href: '/prompts/' }, { name: cat.name, href: `/prompts/${cat.slug}/` }, { name: d.title, href: path }]} />
  <article class="prompt-page">
    <p class="eyebrow">{cat.name} prompt</p>
    <h1>{d.title}</h1>
    <p class="answer">{d.purpose}</p>
    <p class="meta">Works with: {d.tools.join(', ')}</p>
    <section aria-labelledby="p-h" class="prompt-box">
      <div class="prompt-head">
        <h2 id="p-h">The prompt</h2>
        <div class="actions">
          <button type="button" class="btn" data-copy="prompt-text" hidden>Copy prompt</button>
          <span class="copied" role="status" aria-live="polite"></span>
        </div>
      </div>
      <pre id="prompt-text" class="prompt" tabindex="0" set:html={html}></pre>
      <p class="meta">Replace each <mark>{'{{highlighted}}'}</mark> variable with your own details before you run it.</p>
    </section>
    <section aria-labelledby="v-h">
      <h2 id="v-h">Variables</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">Variable</th><th scope="col">What to put</th><th scope="col">Example</th></tr></thead>
          <tbody>{d.variables.map((v) => <tr><td><code>{`{{${v.name}}}`}</code></td><td>{v.description}</td><td>{v.example}</td></tr>)}</tbody>
        </table>
      </div>
    </section>
    {d.image && (
      <figure class="proof">
        <img src={d.image} alt={`Example result for the ${d.title} prompt`} width={d.imageWidth} height={d.imageHeight} loading="lazy" decoding="async" />
        {d.imageCredit && <figcaption>{d.imageCredit}</figcaption>}
      </figure>
    )}
    {tips.length > 0 && (
      <section aria-labelledby="t-h">
        <h2 id="t-h">Tips</h2>
        <ul>{tips.map((t) => <li>{t}</li>)}</ul>
      </section>
    )}
    <AdSlot />
    {related.length > 0 && (
      <section aria-labelledby="r-h">
        <h2 id="r-h">Related prompts</h2>
        <ul class="cards">{related.map((p) => <li><a href={promptUrl(p)}>{p.data.title}</a><span>{p.data.purpose}</span></li>)}</ul>
      </section>
    )}
    <p class="meta">
      Last updated: <time datetime={isoDate(d.updated)}>{isoDate(d.updated)}</time>
      · <a href={`/prompts/${cat.slug}/`}>More {cat.name.toLowerCase()} prompts</a>
      · <a href="/idea-to-prompt/">Make your own with Idea → Prompt</a>
    </p>
  </article>
</BaseLayout>
<script>
  // Copy buttons stay hidden without JS; the prompt is plain selectable text either way.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    b.hidden = false;
    b.addEventListener('click', async () => {
      await navigator.clipboard.writeText(document.getElementById(b.dataset.copy!)!.textContent ?? '');
      const s = b.parentElement!.querySelector('.copied')!;
      s.textContent = 'Copied';
      setTimeout(() => (s.textContent = ''), 2000);
    });
  });
</script>
