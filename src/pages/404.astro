---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolSearch from '../components/ToolSearch.astro';
import { SITE_NAME } from '../site';
---
<BaseLayout title={`Page not found | ${SITE_NAME}`} description="The page you were looking for does not exist. Search our prompts and tutorials, or browse everything below." noindex>
  <h1>Page not found</h1>
  <p>Sorry, that page doesn't exist. Try searching for a prompt or tutorial, or go back to the <a href="/">home page</a>.</p>
  <ToolSearch />
</BaseLayout>
