---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE_NAME } from '../../site';
export async function getStaticPaths() {
  return (await getCollection('authors')).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/authors/${entry.data.slug}/`;
const jsonLd = [{
  '@type': 'Person',
  name: entry.data.name,
  url: new URL(path, Astro.site).href,
  description: entry.data.description,
  worksFor: { '@type': 'Organization', name: SITE_NAME, url: new URL('/', Astro.site).href },
}];
---
<BaseLayout title={`${entry.data.name} | ${SITE_NAME}`} description={entry.data.description} jsonLd={jsonLd}>
  <Breadcrumbs items={[{ name: entry.data.name, href: path }]} />
  <h1>{entry.data.name}</h1>
  <Content />
  <p>The {entry.data.name} also researches and maintains the <a href="/">AI startup case library</a>.</p>
</BaseLayout>
