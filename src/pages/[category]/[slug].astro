---
import { render } from 'astro:content';
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import { liveCalculators } from '../../lib';

export async function getStaticPaths() {
  const calcs = await liveCalculators();
  return calcs.map((entry) => ({ params: { category: entry.data.category, slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<CalculatorLayout entry={entry}><Content /></CalculatorLayout>
