---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE_NAME } from '../site';
import { IDEA_TOOL } from '../lib';
import { CATEGORIES, EXAMPLES, STYLES, generate } from '../lib/ideaToPrompt';
const first = EXAMPLES[0];
const url = new URL(IDEA_TOOL.url, Astro.site).href;
const jsonLd = [{
  '@type': 'WebApplication',
  name: IDEA_TOOL.title,
  url,
  description: IDEA_TOOL.description,
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Any (runs in the browser)',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}];
---
<BaseLayout title={`Idea → Prompt: Turn a Vague Idea into a Detailed AI Prompt | ${SITE_NAME}`} description={IDEA_TOOL.description} jsonLd={jsonLd}>
  <Breadcrumbs items={[{ name: IDEA_TOOL.title, href: IDEA_TOOL.url }]} />
  <p class="eyebrow">Free tool</p>
  <h1>Idea → Prompt</h1>
  <p class="answer">Describe your idea in a sentence, pick what you are making and a style, and get a detailed brief you can paste into ChatGPT, Claude, Gemini, Midjourney or a video tool. It runs entirely in your browser; nothing is sent anywhere.</p>
  <form class="calc idea" id="idea-form">
    <div>
      <label for="idea">Your idea</label>
      <textarea id="idea" name="idea" rows="3" placeholder="e.g. a booking site for a small dog-grooming salon">{first.idea}</textarea>
    </div>
    <div class="row">
      <div>
        <label for="category">Making a…</label>
        <select id="category" name="category">
          {Object.entries(CATEGORIES).map(([k, v]) => <option value={k} selected={k === first.category}>{v}</option>)}
        </select>
      </div>
      <div>
        <label for="style">Style</label>
        <select id="style" name="style">
          {Object.entries(STYLES).map(([k, v]) => <option value={k} selected={k === first.style}>{v}</option>)}
        </select>
      </div>
    </div>
    <div class="row">
      <div>
        <label for="audience">Audience <span class="opt">(optional)</span></label>
        <input id="audience" name="audience" type="text" placeholder="e.g. busy pet owners nearby" />
      </div>
      <div>
        <label for="tone">Tone <span class="opt">(optional)</span></label>
        <input id="tone" name="tone" type="text" placeholder="e.g. warm, a little cheeky" />
      </div>
    </div>
    <fieldset>
      <legend>Try an example</legend>
      {EXAMPLES.map((e, i) => <button type="button" class="chip" data-example={i}>{e.idea}</button>)}
    </fieldset>
  </form>
  <section aria-labelledby="out-h" class="prompt-box">
    <div class="prompt-head">
      <h2 id="out-h">Your prompt</h2>
      <div class="actions">
        <button type="button" class="btn" id="copy">Copy</button>
        <button type="button" class="btn-outline" id="copy-md">Copy as Markdown</button>
        <span class="copied" role="status" aria-live="polite"></span>
      </div>
    </div>
    <pre id="out" class="prompt" tabindex="0">{generate(first)}</pre>
  </section>
  <AdSlot />
  <h2>How it works</h2>
  <p>The tool uses fixed rules and templates, not an AI model, so the same input always gives the same prompt. For websites, landing pages, app screens and brand identities it adds a colour palette with hex codes and checked contrast ratios, a font pairing, a 1.25 type scale, a 4/8pt spacing system, radii, shadows, page structure, components, motion timings and accessibility rules. For images it adds composition, lens, lighting, palette and a negative prompt; for video, a shot list with timings, camera moves, pacing and audio; for copy, audience, voice, structure, length and a call to action.</p>
  <p>Treat the output as a starting brief. Edit anything that does not fit, then paste it into your AI tool. For hand-written prompts on specific tasks, browse the <a href="/prompts/">prompt library</a>, or learn the basics in <a href="/guides/how-to-write-a-good-ai-prompt/">how to write a good AI prompt</a>.</p>
</BaseLayout>
<script>
  import { EXAMPLES, generate, toPlainText, type CategoryKey, type StyleKey } from '../lib/ideaToPrompt';
  const form = document.getElementById('idea-form') as HTMLFormElement;
  const out = document.getElementById('out')!;
  const status = document.querySelector('.copied')!;
  const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
  const md = () => generate({
    idea: field('idea').value, category: field('category').value as CategoryKey, style: field('style').value as StyleKey,
    audience: field('audience').value, tone: field('tone').value,
  });
  const update = () => { out.textContent = md(); };
  form.addEventListener('input', update);
  form.addEventListener('submit', (e) => e.preventDefault());
  form.querySelectorAll<HTMLButtonElement>('[data-example]').forEach((b) => b.addEventListener('click', () => {
    const ex = EXAMPLES[Number(b.dataset.example)];
    field('idea').value = ex.idea; field('category').value = ex.category; field('style').value = ex.style;
    update();
  }));
  const copy = async (text: string) => {
    await navigator.clipboard.writeText(text);
    status.textContent = 'Copied';
    setTimeout(() => (status.textContent = ''), 2000);
  };
  document.getElementById('copy')!.addEventListener('click', () => copy(toPlainText(md())));
  document.getElementById('copy-md')!.addEventListener('click', () => copy(md()));
  update();
</script>
