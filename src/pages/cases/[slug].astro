---
import { render, type CollectionEntry } from 'astro:content';
import type { Article, FAQPage, WithContext } from 'schema-dts';
import { OG_SIZE } from '../../lib/og';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import { INDUSTRIES, SITE_NAME, typeSlug } from '../../site';
import { LABEL_NAME, allCases, caseUrl, isoDate, subSlug } from '../../lib';
export async function getStaticPaths() {
  return (await allCases()).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'cases'> };
const d = entry.data;
const { Content } = await render(entry);
const ind = INDUSTRIES.find((i) => i.slug === d.industry)!;
const path = caseUrl(entry);
type Card = { name: string; value: string | undefined; label?: keyof typeof LABEL_NAME; labelNote?: string; sourceUrl?: string; sourceDate?: string };
const cards: Card[] = [
  { name: 'Monthly revenue', ...d.mrr, value: d.mrr.display },
  { name: 'Total revenue', ...d.totalRevenue, value: d.totalRevenue.display },
  { name: 'Team size', ...d.teamSize, value: d.teamSize.display },
  { name: 'Founded', label: d.foundedYear ? undefined : 'not-disclosed', value: d.foundedDate },
  ...d.metrics,
];
// "At a glance" table under the TL;DR: the facts readers scan for first.
const revenue = d.mrr.value !== null ? { name: 'Revenue', ...d.mrr } : { name: 'Revenue', ...d.totalRevenue };
const glance = [
  revenue,
  { name: 'Team size', ...d.teamSize },
  { name: 'Pricing', ...d.pricing },
  { name: 'Founded', display: d.foundedDate, label: undefined, sourceUrl: undefined, sourceDate: undefined, labelNote: undefined },
  { name: d.founders.length > 1 ? 'Founders' : 'Founder', display: d.founders.join(', '), label: undefined, sourceUrl: undefined, sourceDate: undefined, labelNote: undefined },
];
const related = (await allCases()).filter((c) => c.data.slug !== d.slug && c.data.industry === d.industry).slice(0, 3);
const authorUrl = new URL('/authors/editorial-team/', Astro.site).href;
const image = { url: new URL(`/og/${d.slug}.png`, Astro.site).href, alt: `${d.title} – ${SITE_NAME} case study`, ...OG_SIZE };
const article: WithContext<Article> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.summary,
  url: new URL(path, Astro.site).href,
  image: { '@type': 'ImageObject', url: image.url, width: String(image.width), height: String(image.height) },
  datePublished: isoDate(d.published),
  dateModified: isoDate(d.updated),
  keywords: [d.primaryKeyword, ...d.secondaryKeywords].join(', '),
  about: { '@type': 'Organization', name: d.company, founder: d.founders.map((name) => ({ '@type': 'Person', name })), ...(d.foundedYear ? { foundingDate: String(d.foundedYear) } : {}) },
  author: { '@type': 'Organization', name: 'Editorial team', url: authorUrl },
  publisher: { '@type': 'Organization', name: SITE_NAME },
  citation: d.sources.map((s) => s.url),
};
const faqPage: WithContext<FAQPage> = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const jsonLd = [article, faqPage];
---
<BaseLayout title={`${d.title} | ${SITE_NAME}`} description={d.summary} jsonLd={jsonLd} ogType="article" image={image}>
  <Breadcrumbs items={[{ name: ind.name, href: `/industries/${ind.slug}/` }, { name: d.company, href: path }]} />
  <article class="case">
    <p class="eyebrow">
      <a href={`/industries/${ind.slug}/`}>{ind.name}</a> · <a href={`/types/${typeSlug(d.productType)}/`}>{d.productType}</a>
      {d.appSubcategory && <> · <a href={`/types/app/${subSlug(d.appSubcategory)}/`}>{d.appSubcategory}</a></>}
    </p>
    <h1>{d.title}</h1>
    <p class="answer">{d.summary}</p>
    <div class="tldr" role="note" aria-label="TL;DR"><strong>TL;DR:</strong> {d.tldr}</div>
    <p class="meta">Founder{d.founders.length > 1 ? 's' : ''}: {d.founders.join(', ')} · By <a href="/authors/editorial-team/" rel="author">Editorial team</a> · Updated <time datetime={isoDate(d.updated)}>{isoDate(d.updated)}</time></p>
    <div class="table-wrap">
      <table class="glance" aria-label={`${d.company} at a glance`}>
        <caption>{d.company} at a glance</caption>
        <tbody>
          {glance.map((g) => (
            <tr>
              <th scope="row">{g.name}</th>
              <td>{g.display}{g.label && g.label !== 'not-disclosed' && <span class={`m-label l-${g.label}`}>{g.labelNote ?? LABEL_NAME[g.label]}</span>}{g.sourceUrl && <> <a class="m-src" href={g.sourceUrl} rel="nofollow noopener" target="_blank">Source{g.sourceDate && `, ${g.sourceDate}`}</a></>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <AdSlot />
    <div class="case-body"><Content /></div>
    <section aria-labelledby="faq">
      <h2 id="faq">Frequently asked questions</h2>
      {d.faq.map((f) => <><h3>{f.q}</h3><p>{f.a}</p></>)}
    </section>
    <aside class="data-box" aria-labelledby="data-summary">
      <h2 id="data-summary">{d.company}: data summary</h2>
      <ul class="metric-cards">
        {cards.map((m) => (
          <li>
            <span class="m-name">{m.name}</span>
            <strong>{m.value}</strong>
            {m.label && <span class={`m-label l-${m.label}`}>{m.labelNote ?? LABEL_NAME[m.label]}</span>}
            {m.sourceUrl && <a class="m-src" href={m.sourceUrl} rel="nofollow noopener" target="_blank">Source{m.sourceDate && `, ${m.sourceDate}`}</a>}
          </li>
        ))}
      </ul>
    </aside>
    <section aria-labelledby="sources">
      <h2 id="sources">Sources</h2>
      <ol>{d.sources.map((s) => <li><a href={s.url} rel="nofollow noopener">{s.title}</a> – {s.publisher}{s.date && `, ${s.date}`}</li>)}</ol>
      <p class="meta">Labels: <strong>Founder-reported</strong> = stated by the founder or company; <strong>Verified</strong> = backed by a payment-processor screenshot, TrustMRR or a public platform count; <strong>Media-reported</strong> = published by a news outlet or third party. "Implied" monthly figures are annual figures divided by 12. We never estimate numbers ourselves.</p>
    </section>
    {related.length > 0 && (
      <section aria-labelledby="related"><h2 id="related">More {ind.name} cases</h2>
        <ul>{related.map((c) => <li><a href={caseUrl(c)}>{c.data.title}</a></li>)}</ul>
      </section>
    )}
    <p class="meta">Last updated: <time datetime={isoDate(d.updated)}>{isoDate(d.updated)}</time></p>
  </article>
</BaseLayout>
