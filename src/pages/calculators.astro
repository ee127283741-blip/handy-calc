---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ToolSearch from '../components/ToolSearch.astro';
import { SITE_NAME } from '../site';
---
<BaseLayout title={`All Calculators | ${SITE_NAME}`} description="Every Handy Calc calculator in one place, grouped by category: cooking conversions, home and DIY, crafts and date tools. Search by name or keyword.">
  <Breadcrumbs items={[{ name: 'All calculators', href: '/calculators/' }]} />
  <p class="eyebrow">Directory</p>
  <h1>All calculators</h1>
  <ToolSearch />
</BaseLayout>
