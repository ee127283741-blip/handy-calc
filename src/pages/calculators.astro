---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ToolSearch from '../components/ToolSearch.astro';
import { SITE_NAME } from '../site';
---
<BaseLayout title={`Browse All Prompts & Tutorials | ${SITE_NAME}`} description="Every Handy Calc prompt, tutorial and tool in one place, grouped by category: design, video, images, writing, AI plans, business and privacy. Search by keyword.">
  <Breadcrumbs items={[{ name: 'Browse all', href: '/calculators/' }]} />
  <p class="eyebrow">Directory</p>
  <h1>Browse all prompts &amp; tutorials</h1>
  <p>Start with <a href="/idea-to-prompt/">Idea → Prompt</a> to expand your own idea, or search the library below.</p>
  <ToolSearch />
</BaseLayout>
