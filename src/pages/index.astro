---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_TAGLINE } from '../site';
import { calcUrl, calculatorsByCategory, popularCalculators } from '../lib';
const home = new URL('/', Astro.site).href;
const jsonLd = [
  { '@type': 'WebSite', name: SITE_NAME, url: home, description: SITE_TAGLINE },
  { '@type': 'Organization', name: SITE_NAME, url: home, logo: new URL('/favicon.svg', Astro.site).href },
];
const popular = await popularCalculators();
const groups = await calculatorsByCategory();
---
<BaseLayout title={`${SITE_NAME} – Free Kitchen, DIY, Craft & Date Calculators`} description="Free calculators for cups to grams, oven temperatures and Gas Marks, paint, yarn and days between dates. Every formula is shown and every number is sourced." jsonLd={jsonLd}>
  <section class="hero">
    <p class="eyebrow">Kitchen · Home · Crafts · Calendar</p>
    <h1>Free calculators with sourced answers</h1>
    <p class="answer">{SITE_TAGLINE} Each tool shows its formula, a worked example and the sources behind its reference data.</p>
    <form class="search" role="search" action="/calculators/" method="get">
      <label for="hero-q">Find a calculator</label>
      <div class="search-row">
        <input id="hero-q" name="q" type="search" placeholder="e.g. flour, paint, gas mark" autocomplete="off" />
        <button type="submit" class="btn">Search</button>
      </div>
    </form>
  </section>
  <section aria-labelledby="popular">
    <p class="eyebrow">Most used</p>
    <h2 id="popular">Popular calculators</h2>
    <ul class="cards">
      {popular.map((c) => <li><a href={calcUrl(c)}>{c.data.h1}</a><span>{c.data.metaDescription}</span></li>)}
    </ul>
  </section>
  <section aria-labelledby="browse">
    <p class="eyebrow">Browse</p>
    <h2 id="browse">Calculators by category</h2>
    <ul class="cards">
      {groups.map(({ cat, calcs }) => (
        <li><a href={`/${cat.slug}/`}>{cat.name}</a><span>{cat.description}</span><span class="count">{calcs.length ? `${calcs.length} ${calcs.length === 1 ? 'tool' : 'tools'}` : 'Coming soon'}</span></li>
      ))}
    </ul>
  </section>
</BaseLayout>
