---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import CaseCards from '../components/CaseCards.astro';
import { INDUSTRIES, PRODUCT_TYPES, REVENUE_RANGES, SITE_NAME } from '../site';
import { allCases, caseUrl } from '../lib';
const home = new URL('/', Astro.site).href;
const cases = await allCases();
const years = [...new Set(cases.map((c) => c.data.foundedYear).filter((y): y is number => y !== null))].sort();
const types = PRODUCT_TYPES.filter((t) => cases.some((c) => c.data.productType === t.name));
const inds = INDUSTRIES.filter((i) => cases.some((c) => c.data.industry === i.slug));
const description = 'A library of real AI startup case studies: how founders found the idea, launched, priced and marketed, with sourced, dated revenue figures.';
const jsonLd = [
  { '@type': 'WebSite', name: SITE_NAME, url: home, description, potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: `${home}search/?q={search_term_string}` }, 'query-input': 'required name=search_term_string' } },
  { '@type': 'Organization', name: SITE_NAME, url: home, logo: new URL('/favicon.svg', Astro.site).href },
  { '@type': 'ItemList', name: 'AI startup case library', itemListElement: cases.map((c, n) => ({ '@type': 'ListItem', position: n + 1, url: new URL(caseUrl(c), Astro.site).href, name: c.data.title })) },
];
---
<BaseLayout title={`${SITE_NAME} – AI Startup Case Library: Real Revenue, Sourced`} description={description} jsonLd={jsonLd} image={{ url: new URL('/og/home.png', Astro.site).href, alt: `${SITE_NAME}: real AI startup case studies with sourced, dated revenue figures`, width: 1200, height: 630 }}>
  <section class="hero">
    <p class="eyebrow">AI startup case library</p>
    <h1>How real AI startups got started</h1>
    <p class="answer">{cases.length} case studies of AI products, mostly indie and bootstrapped. Every revenue number links to its source, is dated and labelled founder-reported, verified, media-reported or unverified (a quoted figure we could not confirm against its original source). Where nothing is public we say "Not disclosed".</p>
  </section>
  <form class="filters" id="case-filters" aria-label="Filter cases">
    <label>Industry<select name="industry"><option value="">All</option>{inds.map((i) => <option value={i.slug}>{i.name}</option>)}</select></label>
    <label>Product type<select name="type"><option value="">All</option>{types.map((t) => <option value={t.name}>{t.name}</option>)}</select></label>
    <label>Monthly revenue<select name="revenue"><option value="">All</option>{REVENUE_RANGES.map((r) => <option value={r.slug}>{r.name}</option>)}</select></label>
    <label>Founded<select name="year"><option value="">All</option>{years.map((y) => <option value={y}>{y}</option>)}<option value="unknown">Not disclosed</option></select></label>
  </form>
  <p class="meta" id="case-count" aria-live="polite">Showing {cases.length} of {cases.length} cases</p>
  <CaseCards cases={cases} />
  <AdSlot />
  <p>Browse by <a href="/industries/">industry</a> or <a href="/types/">product type</a>, or compare disclosed figures in the <a href="/rankings/">AI startup revenue rankings</a>.</p>
</BaseLayout>
<script>
  // Light client-side filtering; without JS every case stays visible.
  const form = document.getElementById('case-filters') as HTMLFormElement;
  const items = [...document.querySelectorAll<HTMLLIElement>('.case-cards li')];
  const count = document.getElementById('case-count')!;
  const keys = { industry: 'industry', type: 'type', revenue: 'revenue', year: 'year' } as const;
  const apply = () => {
    const f = new FormData(form);
    let shown = 0;
    for (const li of items) {
      const ok = (Object.keys(keys) as (keyof typeof keys)[]).every((k) => !f.get(k) || li.dataset[keys[k]] === f.get(k));
      li.hidden = !ok;
      if (ok) shown++;
    }
    count.textContent = `Showing ${shown} of ${items.length} cases`;
  };
  form.addEventListener('change', apply);
</script>
