---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { CATEGORIES, PROMPT_CATEGORIES, SITE_NAME, SITE_TAGLINE } from '../site';
import { allPrompts, liveGuides, promptUrl } from '../lib';
const home = new URL('/', Astro.site).href;
const jsonLd = [
  { '@type': 'WebSite', name: SITE_NAME, url: home, description: SITE_TAGLINE },
  { '@type': 'Organization', name: SITE_NAME, url: home, logo: new URL('/favicon.svg', Astro.site).href },
];
const prompts = await allPrompts();
const count = (slug: string) => prompts.filter((p) => p.data.category === slug).length;
const guides = (await liveGuides()).sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf()).slice(0, 6);
---
<BaseLayout title={`${SITE_NAME} – AI Prompt Library, Idea → Prompt Tool & AI Tutorials`} description="Copy-ready AI prompts for web design, motion, video, camera moves, images and writing, a free Idea → Prompt generator, and practical AI tutorials." jsonLd={jsonLd}>
  <section class="hero">
    <p class="eyebrow">Prompts · Design · Video · Images · Writing</p>
    <h1>Better prompts, ready to copy</h1>
    <p class="answer">{SITE_TAGLINE} Turn a rough idea into a detailed brief in seconds.</p>
    <p class="hero-cta"><a class="btn btn-lg" href="/idea-to-prompt/">Try Idea → Prompt</a> <a href="/prompts/">or browse {prompts.length} prompts</a></p>
    <form class="search" role="search" action="/calculators/" method="get">
      <label for="hero-q">Search prompts and tutorials</label>
      <div class="search-row">
        <input id="hero-q" name="q" type="search" placeholder="e.g. landing page, orbit shot, product photo" autocomplete="off" />
        <button type="submit" class="btn">Search</button>
      </div>
    </form>
  </section>
  <section aria-labelledby="cats">
    <p class="eyebrow">Prompt library</p>
    <h2 id="cats">Prompt categories</h2>
    <ul class="cards">
      {PROMPT_CATEGORIES.map((c) => <li><a href={`/prompts/${c.slug}/`}>{c.name}</a><span>{c.description}</span><span class="count">{count(c.slug)} prompts</span></li>)}
    </ul>
  </section>
  <section aria-labelledby="latest">
    <p class="eyebrow">New</p>
    <h2 id="latest">Latest prompts</h2>
    <ul class="cards">
      {prompts.slice(0, 6).map((p) => <li><a href={promptUrl(p)}>{p.data.title}</a><span>{p.data.purpose}</span></li>)}
    </ul>
  </section>
  <AdSlot />
  <section aria-labelledby="tutorials">
    <p class="eyebrow">Learn</p>
    <h2 id="tutorials">AI tutorials</h2>
    <ul class="cards">
      {guides.map((g) => <li><a href={`/guides/${g.data.slug}/`}>{g.data.title}</a><span>{g.data.metaDescription}</span></li>)}
    </ul>
    <p>Browse by topic: {CATEGORIES.map((c, n) => <>{n > 0 && ' · '}<a href={`/${c.slug}/`}>{c.name}</a></>)}</p>
  </section>
</BaseLayout>
