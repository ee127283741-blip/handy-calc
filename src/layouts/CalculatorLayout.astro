---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AdSlot from '../components/AdSlot.astro';
import { ADS_ON } from '../ads';
import Faq from '../components/Faq.astro';
import Sources from '../components/Sources.astro';
import { WIDGETS } from '../components/calculators';
import { getCategory, SITE_NAME } from '../site';
import { calcUrl, isoDate, liveCalculators } from '../lib';

interface Props { entry: CollectionEntry<'calculators'> }
const { entry } = Astro.props;
const d = entry.data;
const cat = getCategory(d.category);
const Widget = WIDGETS[d.calculator];
if (!Widget) throw new Error(`Unknown calculator component "${d.calculator}" in ${entry.id}`);
const all = await liveCalculators();
const related = d.related.map((s) => all.find((c) => c.data.slug === s)).filter((c) => !!c);
const sameCat = all.filter((c) => c.data.category === d.category && c.data.slug !== d.slug && !d.related.includes(c.data.slug));
const relatedList = [...related, ...sameCat].slice(0, 5);
// With ads off there is no wrapper, so the layout is unchanged.
const Wrap = ADS_ON ? 'div' : Fragment;
const url = new URL(calcUrl(entry), Astro.site).href;
const authorUrl = new URL('/authors/editorial-team/', Astro.site).href;
const jsonLd = [{
  '@type': 'WebApplication',
  name: d.h1,
  url,
  description: d.metaDescription,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  dateModified: isoDate(d.updated),
  author: { '@type': 'Person', name: d.author, url: authorUrl },
  publisher: { '@type': 'Organization', name: SITE_NAME, url: new URL('/', Astro.site).href },
}];
---
<BaseLayout title={d.title} description={d.metaDescription} jsonLd={jsonLd}>
  <Breadcrumbs items={[{ name: cat.name, href: `/${cat.slug}/` }, { name: d.h1, href: calcUrl(entry) }]} />
  <Wrap class={ADS_ON ? 'ad-layout' : undefined}>
  <article>
    <h1>{d.h1}</h1>
    <p class="answer">{d.directAnswer}</p>
    <Widget />
    <AdSlot />
    <slot />
    <AdSlot />
    <Faq faqs={d.faqs} />
    <section aria-labelledby="related">
      <h2 id="related">Related calculators</h2>
      <ul>
        {relatedList.map((c) => <li><a href={calcUrl(c)}>{c.data.h1}</a></li>)}
        <li><a href={`/${cat.slug}/`}>All {cat.name.toLowerCase()} calculators</a></li>
      </ul>
    </section>
    <Sources sources={d.sources} />
    <AdSlot />
    <p class="meta">
      Written by <a href="/authors/editorial-team/">{d.author}</a>{d.reviewedBy && <> · Reviewed by {d.reviewedBy}</>}
      · Last updated: <time datetime={isoDate(d.updated)}>{isoDate(d.updated)}</time>
      · <a href="/editorial-policy/">Editorial policy</a>
    </p>
    <p class="disclaimer">Disclaimer: results are estimates for general guidance only. Prices change; check the provider's official pricing page before making purchasing decisions. This is not financial advice.</p>
  </article>
  <AdSlot sidebar />
  </Wrap>
</BaseLayout>
