---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AdSlot from '../components/AdSlot.astro';
import Faq from '../components/Faq.astro';
import Sources from '../components/Sources.astro';
import { SITE_NAME, getCategory } from '../site';
import { allItems, inCategory, isoDate } from '../lib';
interface Props { entry: CollectionEntry<'guides'> }
const d = Astro.props.entry.data;
const path = `/guides/${d.slug}/`;
const cat = getCategory(d.category);
const others = (await allItems()).filter((i) => i.type === 'guide' && i.slug !== d.slug);
const relatedGuides = [
  ...others.filter((g) => d.subtopic && g.subtopic === d.subtopic),
  ...others.filter((g) => !(d.subtopic && g.subtopic === d.subtopic) && (inCategory(g, d.category) || d.alsoIn.some((c) => inCategory(g, c)))),
].slice(0, 3);
const jsonLd = [{
  '@type': 'Article',
  headline: d.title,
  description: d.metaDescription,
  url: new URL(path, Astro.site).href,
  datePublished: isoDate(d.published),
  dateModified: isoDate(d.updated),
  author: { '@type': 'Person', name: d.author, url: new URL('/authors/editorial-team/', Astro.site).href },
  publisher: { '@type': 'Organization', name: SITE_NAME },
}];
---
<BaseLayout title={`${d.title} | ${SITE_NAME}`} description={d.metaDescription} jsonLd={jsonLd}>
  <Breadcrumbs items={[{ name: cat.name, href: `/${cat.slug}/` }, { name: d.title, href: path }]} />
  <article>
    <h1>{d.title}</h1>
    <slot />
    <AdSlot />
    {d.faqs.length > 0 && <Faq faqs={d.faqs} />}
    {relatedGuides.length > 0 && (
      <section aria-labelledby="related">
        <h2 id="related">Related tutorials</h2>
        <ul>
          {relatedGuides.map((g) => <li><a href={g.url}>{g.title}</a></li>)}
          <li><a href={`/${cat.slug}/`}>More on {cat.name.toLowerCase()}</a></li>
          <li><a href="/prompts/">Prompt library</a> and <a href="/idea-to-prompt/">Idea → Prompt</a></li>
        </ul>
      </section>
    )}
    <Sources sources={d.sources} />
    <p class="meta">
      Written by <a href="/authors/editorial-team/">{d.author}</a>
      · Last updated: <time datetime={isoDate(d.updated)}>{isoDate(d.updated)}</time>
      {d.lastVerified && <> · Facts last verified: <time datetime={isoDate(d.lastVerified)}>{isoDate(d.lastVerified)}</time></>}
      · <a href="/editorial-policy/">Editorial policy</a>
    </p>
    <AdSlot />
  </article>
</BaseLayout>
