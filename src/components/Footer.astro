---
import { CATEGORIES, PROMPT_CATEGORIES, SITE_NAME } from '../site';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-cols">
      <div>
        <p class="logo">{SITE_NAME}</p>
        <p>Copy-ready AI prompts and practical AI tutorials. Prices and facts are sourced and dated.</p>
      </div>
      <nav aria-labelledby="f-cats">
        <h2 id="f-cats" class="eyebrow">Prompts</h2>
        <ul>
          <li><a href="/idea-to-prompt/">Idea → Prompt</a></li>
          {PROMPT_CATEGORIES.map((c) => <li><a href={`/prompts/${c.slug}/`}>{c.name}</a></li>)}
        </ul>
      </nav>
      <nav aria-labelledby="f-pop">
        <h2 id="f-pop" class="eyebrow">Tutorials</h2>
        <ul>{CATEGORIES.map((c) => <li><a href={`/${c.slug}/`}>{c.name}</a></li>)}</ul>
      </nav>
      <nav aria-labelledby="f-site">
        <h2 id="f-site" class="eyebrow">Handy Calc</h2>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy-policy/">Privacy policy</a></li>
          <li><a href="/terms/">Terms of use</a></li>
          <li><a href="/editorial-policy/">Editorial policy</a></li>
          <li><a href="/authors/editorial-team/">Editorial team</a></li>
        </ul>
      </nav>
    </div>
    <p class="fine">© {new Date().getFullYear()} {SITE_NAME}. Check AI output and current prices on each provider's official page before you rely on them.</p>
  </div>
</footer>
