---
import { INDUSTRIES, SITE_NAME } from '../site';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-cols">
      <div>
        <p class="logo">{SITE_NAME}</p>
        <p>Real AI startup case studies with sourced, dated numbers.</p>
      </div>
      <nav aria-labelledby="f-cases">
        <h2 id="f-cases" class="eyebrow">Cases</h2>
        <ul>
          <li><a href="/">Case library</a></li>
          {INDUSTRIES.map((c) => <li><a href={`/industries/${c.slug}/`}>{c.name}</a></li>)}
          <li><a href="/types/">By product type</a></li>
        </ul>
      </nav>
      <nav aria-labelledby="f-site">
        <h2 id="f-site" class="eyebrow">{SITE_NAME}</h2>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy-policy/">Privacy policy</a></li>
          <li><a href="/terms/">Terms of use</a></li>
          <li><a href="/editorial-policy/">Editorial policy</a></li>
          <li><a href="/authors/editorial-team/">Editorial team</a></li>
        </ul>
      </nav>
    </div>
    <p class="fine">© {new Date().getFullYear()} {SITE_NAME}. Revenue figures are as reported by the cited sources on the dates shown; we do not audit them.</p>
  </div>
</footer>
