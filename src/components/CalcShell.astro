---
interface Props { id: string; label: string }
const { id, label } = Astro.props;
---
<section class="calc" id={id} aria-label={label}>
  <form onsubmit="return false">
    <slot />
  </form>
  <output aria-live="polite"></output>
  <noscript><p>This calculator needs JavaScript. The formula and reference table below work without it.</p></noscript>
  <div class="actions">
    <button type="button" data-copy>Copy result</button>
    <button type="button" class="secondary" data-reset>Reset</button>
  </div>
</section>
