---
import { CATEGORIES, PROMPT_CATEGORIES } from '../site';
import { TYPE_LABEL, allItems } from '../lib';
const items = await allItems();
const groups = [
  ...PROMPT_CATEGORIES.map((c) => ({ href: `/prompts/${c.slug}/`, slug: c.slug, name: `${c.name} prompts` })),
  ...CATEGORIES.map((c) => ({ href: `/${c.slug}/`, slug: c.slug, name: c.name })),
].map((g) => ({ ...g, list: items.filter((i) => i.category === g.slug) })).filter((g) => g.list.length);
---
<form class="search" role="search" action="/calculators/" onsubmit="return false">
  <label for="tool-q">Search prompts and tutorials</label>
  <input id="tool-q" name="q" type="search" placeholder="e.g. landing page, camera orbit, tokens" autocomplete="off" />
</form>
<ul id="tool-results" class="cards" hidden></ul>
<p id="tool-none" hidden>Nothing matches that search.</p>
<div id="tool-list">
  {groups.map(({ href, slug, name, list }) => (
    <section aria-labelledby={`g-${slug}`} class="tool-group">
      <h2 id={`g-${slug}`}><a href={href}>{name}</a></h2>
      <ul class="cards">
        {list.map((i) => <li><a href={i.url}>{i.title}</a><span>{i.description}</span><span class="count">{TYPE_LABEL[i.type]}</span></li>)}
      </ul>
    </section>
  ))}
</div>
<script>
  type Entry = { title: string; url: string; type: string; category: string; description: string };
  const q = document.getElementById('tool-q') as HTMLInputElement;
  const results = document.getElementById('tool-results')!;
  let index: Promise<Entry[]> | undefined;
  const load = () => (index ??= fetch('/search-index.json').then((r) => r.json() as Promise<Entry[]>));
  const LABEL: Record<string, string> = { tool: 'Tool', guide: 'Tutorial', prompt: 'Prompt' };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
  const run = async () => {
    const words = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    document.getElementById('tool-list')!.hidden = !!words.length;
    if (!words.length) { results.hidden = true; document.getElementById('tool-none')!.hidden = true; return; }
    const hits = (await load()).filter((e) => words.every((w) => `${e.title} ${e.description} ${e.category} ${e.type}`.toLowerCase().includes(w)));
    results.innerHTML = hits.map((e) => `<li><a href="${e.url}">${esc(e.title)}</a><span>${esc(e.description)}</span><span class="count">${LABEL[e.type]}</span></li>`).join('');
    results.hidden = !hits.length;
    document.getElementById('tool-none')!.hidden = !!hits.length;
  };
  q.addEventListener('focus', load, { once: true });
  q.addEventListener('input', run);
  q.value = new URLSearchParams(location.search).get('q') ?? '';
  if (q.value) run();
  if (q.value || location.hash === '#tool-q') q.focus();
</script>
