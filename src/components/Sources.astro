---
interface Props { sources: { title: string; url: string; publisher: string }[] }
const { sources } = Astro.props;
---
<section aria-labelledby="sources">
  <h2 id="sources">Sources</h2>
  <ul>
    {sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a> — {s.publisher}</li>)}
  </ul>
</section>
