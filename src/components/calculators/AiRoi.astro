---
import CalcShell from '../CalcShell.astro';
---
<CalcShell id="calc-roi" label="AI ROI calculator">
  <div class="row">
    <div><label for="roi-emp">Employees with a seat</label><input id="roi-emp" inputmode="numeric" value="10" /></div>
    <div><label for="roi-adopt">Adoption rate (%)</label><input id="roi-adopt" inputmode="decimal" value="50" /><small>Share of seat holders who actually save time.</small></div>
    <div><label for="roi-hrs">Hours saved per active user per week</label><input id="roi-hrs" inputmode="decimal" value="1" /></div>
    <div><label for="roi-rate">Loaded hourly cost ($)</label><input id="roi-rate" inputmode="decimal" value="40" /><small>Wage plus benefits, taxes and overhead.</small></div>
    <div><label for="roi-seat">Tool cost per seat per month ($)</label><input id="roi-seat" inputmode="decimal" value="25" /></div>
    <div><label for="roi-setup">One-off setup cost ($)</label><input id="roi-setup" inputmode="decimal" value="1000" /><small>Training, configuration, policy work.</small></div>
  </div>
</CalcShell>
<script>
  import { $, fmt, usd, wire } from '../../calculators/ui';
  import { roi } from '../../calculators/roi';
  const root = document.getElementById('calc-roi')!;
  const num = (sel: string) => Number($(root, sel).value);
  const run = wire(root, () => {
    const i = { employees: num('#roi-emp'), adoptionPct: num('#roi-adopt'), hoursSavedPerWeek: num('#roi-hrs'), hourlyCost: num('#roi-rate'), seatCostPerMonth: num('#roi-seat'), setupCost: num('#roi-setup') };
    if (Object.values(i).some((v) => !(v >= 0 && Number.isFinite(v))) || i.adoptionPct > 100) return 'Enter zero or positive numbers (adoption 0–100%)';
    const r = roi(i);
    const payback = Number.isFinite(r.paybackMonths) ? `payback ${fmt(r.paybackMonths, 1)} months` : 'no payback';
    const pct = Number.isFinite(r.roiPct) ? `${fmt(r.roiPct, 0)}%` : 'n/a';
    return `${fmt(r.hoursSaved, 1)} h/mo saved · ${usd(r.value)} value · net ${usd(r.net)}/mo · first-year ROI ${pct} · ${payback}`;
  });
  run();
</script>
