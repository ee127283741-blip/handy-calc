---
import CalcShell from '../CalcShell.astro';
---
<CalcShell id="calc-days" label="Days between dates calculator">
  <div class="row">
    <div><label for="d-start">Start date</label><input id="d-start" type="date" value="2026-01-01" /></div>
    <div><label for="d-end">End date</label><input id="d-end" type="date" value="2026-12-31" /></div>
  </div>
  <label class="check"><input type="checkbox" id="d-inc" /> Include the end date (count both days)</label>
</CalcShell>
<script>
  import { $, fmt, wire } from '../../calculators/ui';
  import { breakdown, businessDaysBetween, daysBetween } from '../../calculators/daysBetween';
  const root = document.getElementById('calc-days')!;
  const s = $(root, '#d-start');
  const e = $(root, '#d-end');
  const inc = $(root, '#d-inc');
  const today = () => {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  };
  const setDefault = () => { s.value = today(); };
  const run = wire(root, () => {
    try {
      const d = daysBetween(s.value, e.value, inc.checked);
      const b = businessDaysBetween(s.value, e.value, inc.checked);
      const w = breakdown(d);
      return `${fmt(d, 0)} days (${w.weeks} weeks, ${w.days} days) · ${fmt(b, 0)} weekdays (Mon–Fri)`;
    } catch { return 'Pick two valid dates'; }
  });
  setDefault();
  root.addEventListener('calc-reset', setDefault);
  run();
</script>
