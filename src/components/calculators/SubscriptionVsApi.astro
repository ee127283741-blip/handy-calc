---
import CalcShell from '../CalcShell.astro';
import { API_MODELS, PLANS } from '../../data/ai-pricing';
---
<CalcShell id="calc-sub" label="AI subscription vs API calculator">
  <div class="row">
    <div><label for="sub-plan">Subscription plan</label>
      <select id="sub-plan">{PLANS.map((p) => <option value={p.id} selected={p.id === 'claude-pro'}>{p.name} (${p.monthlyUSD}/mo)</option>)}</select>
    </div>
    <div><label for="sub-model">Comparable API model</label>
      <select id="sub-model">{API_MODELS.map((m) => <option value={m.id} selected={m.id === 'claude-sonnet-5-5'}>{m.provider} {m.name}</option>)}</select>
    </div>
  </div>
  <div class="row">
    <div><label for="sub-mpd">Messages per day</label><input id="sub-mpd" inputmode="numeric" value="30" /></div>
    <div><label for="sub-in">Avg input tokens per message</label><input id="sub-in" inputmode="numeric" value="1500" /><small>Include the chat history resent with each message.</small></div>
    <div><label for="sub-out">Avg output tokens per message</label><input id="sub-out" inputmode="numeric" value="600" /></div>
    <div><label for="sub-days">Days per month</label><input id="sub-days" inputmode="numeric" value="30" /></div>
  </div>
  <p id="sub-src"></p>
  <p><small>Raw token cost only. Plans have usage limits and include features (apps, file uploads, image tools, web search) that the API prices separately or does not offer.</small></p>
</CalcShell>
<script>
  import { $, fmt, todayIso, usd, wire } from '../../calculators/ui';
  import { getModel, getPlan } from '../../data/ai-pricing';
  import { compareSubscription } from '../../calculators/subscriptionVsApi';
  const root = document.getElementById('calc-sub')!;
  const src = $<HTMLParagraphElement>(root, '#sub-src');
  const num = (sel: string) => Number($(root, sel).value);
  const link = (href: string, text: string) => Object.assign(document.createElement('a'), { href, rel: 'noopener', textContent: text });
  const run = wire(root, () => {
    const plan = getPlan($<HTMLSelectElement>(root, '#sub-plan').value);
    const model = getModel($<HTMLSelectElement>(root, '#sub-model').value);
    src.replaceChildren('Prices verified: ', link(plan.sourceUrl, `${plan.name} ${plan.lastVerified}`), ' · ', link(model.sourceUrl, `${model.name} ${model.lastVerified}`), plan.notes ? ` · ${plan.notes}` : '');
    const u = { messagesPerDay: num('#sub-mpd'), inputTokens: num('#sub-in'), outputTokens: num('#sub-out'), daysPerMonth: num('#sub-days'), date: todayIso() };
    if (Object.values(u).some((v) => typeof v === 'number' && !(v >= 0 && Number.isFinite(v)))) return 'Enter zero or positive numbers in every field';
    const r = compareSubscription(plan, model, u);
    const be = Number.isFinite(r.breakEvenPerDay) ? `break-even ≈ ${fmt(r.breakEvenPerDay, 0)} messages/day` : 'no break-even';
    return `API ${usd(r.apiMonthly)}/mo vs plan ${usd(r.planMonthly)}/mo · ${be}`;
  });
  run();
</script>
