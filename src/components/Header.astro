---
import { CATEGORIES, PROMPT_CATEGORIES, SITE_NAME } from '../site';
const path = Astro.url.pathname;
const menus = [
  { name: 'Prompts', base: '/prompts/', all: 'All prompts', links: PROMPT_CATEGORIES.map((c) => ({ name: c.name, href: `/prompts/${c.slug}/` })) },
  { name: 'Tutorials', base: '', all: 'All tutorials', links: CATEGORIES.map((c) => ({ name: c.name, href: `/${c.slug}/` })) },
];
const inMenu = (m: (typeof menus)[number]) => m.links.some((l) => path.startsWith(l.href)) || (!!m.base && path === m.base);
---
<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/">{SITE_NAME}</a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Show menu" />
    <label for="nav-toggle" class="nav-burger" aria-hidden="true"><span></span></label>
    <nav aria-label="Main" class="nav">
      <ul class="nav-cats">
        {menus.map((m) => (
          <li>
            <details class="drop">
              <summary aria-current={inMenu(m) ? 'true' : undefined}>{m.name}</summary>
              <ul>
                {m.links.map((l) => <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.name}</a></li>)}
                <li><a href={m.base || '/calculators/'}>{m.all}</a></li>
              </ul>
            </details>
          </li>
        ))}
        <li><a class="nav-link" href="/idea-to-prompt/" aria-current={path === '/idea-to-prompt/' ? 'page' : undefined}>Idea → Prompt</a></li>
      </ul>
      <div class="nav-actions">
        <a class="nav-search" href="/calculators/#tool-q">Search</a>
        <a class="btn-dark" href="/calculators/" aria-current={path === '/calculators/' ? 'page' : undefined}>Browse all</a>
      </div>
    </nav>
  </div>
</header>
<script>
  // Keep one dropdown open at a time; close on outside click or Escape. Works without JS too.
  const drops = [...document.querySelectorAll<HTMLDetailsElement>('.drop')];
  drops.forEach((d) => d.addEventListener('toggle', () => { if (d.open) drops.forEach((o) => o !== d && (o.open = false)); }));
  document.addEventListener('click', (e) => drops.forEach((d) => !d.contains(e.target as Node) && (d.open = false)));
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const d = drops.find((o) => o.open);
    if (d) { d.open = false; d.querySelector('summary')!.focus(); }
  });
</script>
